PORT=8000
DATA_DIR=/app/data
MAX_WORKSPACE_BYTES=10737418240
SAFETY_BYTES=268435456
# Generate securely, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_TOKEN=
ACCOUNT_PLAN=free
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN/drive/callback
# Fernet key; store separately from drive.enc and backups.
TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_FOLDER_ID=
# Optional legacy admin credential; prefer encrypted OAuth token from authorize flow.
GOOGLE_REFRESH_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
BACKEND_URL=https://YOUR-DOMAIN
